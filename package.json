{
  "name": "stream-deck-home-weather-station",
  "version": "0.1.0",
  "description": "Unofficial Stream Deck plugin that shows data from a Netatmo weather station: temperature, humidity, CO2, noise, pressure, rain and wind. Independent project, not affiliated with or endorsed by Netatmo, Elgato or Corsair.",
  "author": "Stefan Schwetschke <stefan@schwetschke.de>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geggo98/stream-deck-home-weather-station.git"
  },
  "homepage": "https://github.com/geggo98/stream-deck-home-weather-station#readme",
  "bugs": "https://github.com/geggo98/stream-deck-home-weather-station/issues",
  "scripts": {
    "sync:version": "tsx scripts/sync-manifest-version.ts",
    "verify:manifest": "tsx scripts/verify-release-manifest.ts",
    "build": "tsx scripts/sync-manifest-version.ts && rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "watch": "tsx scripts/sync-manifest-version.ts --debug && rollup -c -w --watch.onEnd=\"streamdeck restart de.schwetschke.sd.home-weather-station\"",
    "validate": "streamdeck validate de.schwetschke.sd.home-weather-station.sdPlugin --no-update-check",
    "pack": "npm run verify:manifest && streamdeck pack de.schwetschke.sd.home-weather-station.sdPlugin --output . --force --no-update-check",
    "scan": "osv-scanner scan source --lockfile=package-lock.json --licenses",
    "scan:vulns": "osv-scanner scan source --lockfile=package-lock.json",
    "test": "node --test tests/*.test.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "generate": "npm run generate:icons && npm run generate:manifest",
    "probe": "tsx scripts/probe-api.ts",
    "capture:fixture": "tsx scripts/capture-fixture.ts",
    "render": "python3 -I scripts/render-with-codex.py scripts/render-jobs.json assets/rendered"
  },
  "type": "module",
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "lucide-static": "^1.27.0",
    "rollup": "^4.62.2",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  }
}
